{
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "[sql]": {
    "editor.defaultFormatter": "adpyke.vscode-sql-formatter",
  },
  "cSpell.diagnosticLevel": "Hint",
  "cSpell.enabled": true,
  "cSpell.language": "en-GB",
  "cSpell.maxDuplicateProblems": 1,
  "cSpell.maxNumberOfProblems": 10,
  "cSpell.userWords": ["genai", "vectorstores"],
  "coverage-gutters.coverageFileNames": [
    "lcov.info",
    "cov.xml",
    "coverage.xml",
    "jacoco.xml",
    "coverage.cobertura.xml",
  ],
  "coverage-gutters.showGutterCoverage": true,
  "coverage-gutters.showLineCoverage": true,
  "editor.bracketPairColorization.enabled": false,
  "editor.codeLens": true,
  "editor.cursorStyle": "line",
  "editor.fontFamily": "JetbrainsMono NF",
  "editor.fontLigatures": true,
  "editor.guides.bracketPairs": false,
  "editor.insertSpaces": true,
  "editor.lineNumbers": "on",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "alt",
  "editor.smoothScrolling": false,
  "editor.suggestSelection": "first",
  "editor.tabSize": 4,
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 9,
  "files.associations": {
    "*.pyproj": "xml",
    "*.schema": "ini",
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.svn": true,
    "**/.venv": true,
    "**/CVS": true,
    "**/__pycache__": true,
    "**/htmlcov": true,
    "**/target": true,
    ".coverage": true,
    "dist": true,
  },
  "files.trimTrailingWhitespace": false,
  "git.mergeEditor": false,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": false,
    "suppressCommitNotFoundWarning": false,
    "suppressFileNotUnderSourceControlWarning": false,
    "suppressGitVersionWarning": false,
    "suppressLineUncommittedWarning": false,
    "suppressNoRepositoryWarning": false,
  },
  "gitlens.keymap": "none",
  "gitlens.views.commits.avatars": true,
  "gitlens.views.commits.pullRequests.enabled": false,
  "gitlens.views.commits.pullRequests.showForBranches": false,
  "gitlens.views.commits.showBranchComparison": false,
  "gitlens.views.fileHistory.avatars": true,
  "go.coverOnSave": true,
  "go.coverOnSingleTestFile": true,
  "go.coverageOptions": "showUncoveredCodeOnly",
  "go.inlayHints.assignVariableTypes": false,
  "go.inlayHints.compositeLiteralFields": false, //true,
  "go.inlayHints.compositeLiteralTypes": false, //true,
  "go.inlayHints.constantValues": false,
  "go.inlayHints.functionTypeParameters": false, //true,
  "go.inlayHints.parameterNames": false, // true,
  "go.inlayHints.rangeVariableTypes": false,
  "go.toolsManagement.autoUpdate": true,
  "gopls": {
    "formatting.gofumpt": true,

    "ui.codelenses": {
      "gc_details": true,
    },
    "ui.diagnostic.staticcheck": true,
    "hints": {
      "compositeLiteralFields": true,
      "constantValues": true,
      "functionTypeParameters": true,
      "parameterNames": true,
      "ignoredError": true
    },

    "analyses": {
      "nilness": true,
      "unusedparams": true,
      "unusedwrite": true,
      "shadow": true
    },

    "completeFunctionCalls": true
  },
  "http.proxyStrictSSL": false,
  "markdown.editor.pasteUrlAsFormattedLink.enabled": "never",
  "notebook.cellExecutionTimeVerbosity": "verbose",
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left",
  },
  "notebook.lineNumbers": "on",
  "search.collapseResults": "alwaysCollapse",
  "search.exclude": {
    "**/*.code-search": true,
    "**/bin/": true,
    "**/bower_components": true,
    "**/node_modules": true,
    "**/obj/": true,
  },
  "search.useIgnoreFiles": true,
  "terminal.integrated.allowChords": false,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "args": ["-l"],
      "path": "zsh",
    },
  },
  "window.zoomLevel": 2,
  "workbench.commandPalette.history": 30,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.mouseBackForwardToNavigate": true,
  "workbench.editor.wrapTabs": true,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook",
  },
  "workbench.layoutControl.enabled": false,
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "vue.server.hybridMode": "typeScriptPluginOnly",
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "GitHub.vscode-pull-request-github",
  ],
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "editor.inlineSuggest.enabled": false,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.browser.openLocalhostLinks": false
}
